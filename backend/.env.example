# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=Cluster0

# Server Configuration
PORT=8000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-jwt-secret-min-32-characters-long
REFRESH_SECRET=your-refresh-token-secret-min-32-characters-long

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# CORS Configuration (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5001
